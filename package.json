{
  "name": "fs-webrtc",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone browser WebRTC softphone POC for FreeSWITCH (SIP over WSS via SIP.js)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "serve": "node server/server.mjs"
  },
  "dependencies": {
    "sip.js": "0.21.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}

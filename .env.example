# FS-WebRTC configuration example. Copy to .env.local and adjust.
# NEVER put SIP passwords in this file – they are typed into the login screen at runtime.

# ---- Browser app defaults (shown pre-filled on the login screen, user can change) ----
# SIP domain / realm (FreeSWITCH "domain", usually the server IP)
VITE_SIP_DOMAIN=192.168.1.133
# WSS URL. Leave empty to use same-origin  wss://<page-host>/sip  (recommended – Option A proxy)
VITE_SIP_WSS_URL=

# ---- Local development only (vite dev server) ----
# mkcert localhost certificate (generated into ./certs, git-ignored)
DEV_TLS_CERT=certs/localhost.pem
DEV_TLS_KEY=certs/localhost-key.pem
# Optional: proxy /sip to FreeSWITCH plain WS for local testing.
# SECURITY-SENSITIVE: unencrypted SIP signalling over the LAN. Lab use only.
# DEV_SIP_WS_UPSTREAM=ws://192.168.1.133:5066
